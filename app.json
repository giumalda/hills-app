{
  "expo": {
    "name": "Hill's Burger",
    "slug": "hills-burger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hillsburger",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFD90F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.giumalda.hillsburger"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD90F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
