{
  "expo": {
    "name": "Hill's Burger",
    "slug": "hills-burger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-light.png",
    "scheme": "hillsburger",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/hills-logo-black.png",
      "imageWidth": 260,
      "backgroundColor": "#FFD90F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/app-icon-light.png",
        "dark": "./assets/images/app-icon-dark.png",
        "tinted": "./assets/images/app-icon-monochrome.png"
      },
      "bundleIdentifier": "com.giumalda.hillsburger"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "package": "com.giumalda.hillsburger"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FFD90F",
          "defaultChannel": "promozioni",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "280709b4-e829-4c1f-8a5e-32242c52288d"
      }
    },
    "owner": "giumalda",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/280709b4-e829-4c1f-8a5e-32242c52288d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
